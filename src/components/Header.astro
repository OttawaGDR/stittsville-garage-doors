---
import { site } from '../data/site';
import PhoneLink from './PhoneLink.astro';

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/blog/', label: 'Blog' },
  { href: '/emergency/', label: 'Emergency' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-primary-100 bg-white/95 backdrop-blur">
  <div class="container-page flex items-center gap-6 py-4 xl:gap-8">
    <a href="/" class="nav-link flex shrink-0 items-center no-underline hover:no-underline">
        <img
          src="/images/logo.svg"
          alt={site.name}
          width="280"
          height="56"
          class="h-9 w-auto md:h-10"
          fetchpriority="high"
        />
    </a>
    <nav class="hidden items-center gap-6 xl:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link text-sm font-semibold uppercase tracking-wide no-underline hover:text-accent-600',
              path.startsWith(item.href.replace(/\/$/, '')) && item.href !== '/' ? 'text-accent-600' : 'text-primary-700',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a
      href="/#request-quote"
      class="nav-link ml-auto hidden whitespace-nowrap rounded-lg border-2 border-accent-500 px-3 py-2.5 text-xs font-bold uppercase tracking-wide text-accent-600 no-underline transition hover:bg-accent-50 xl:ml-0 xl:inline-flex xl:items-center xl:justify-center"
    >
      Free Quote
    </a>
    <PhoneLink
      showIcon
      singleLine
      class="!hidden shrink-0 !px-4 !py-2.5 !text-sm xl:!inline-flex"
      ariaLabel={`Call ${site.name} at ${site.phone}`}
    />
    <button
      type="button"
      class="ml-auto rounded border border-primary-100 p-2 xl:hidden"
      aria-label="Open menu"
      id="menu-toggle"
    >
      <svg width="24" height="24" class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-primary-100 bg-white xl:hidden" aria-label="Mobile">
    <ul class="container-page flex flex-col gap-2 py-4">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="nav-link block py-2 font-semibold text-primary-700 no-underline">
            {item.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a
          href="/#request-quote"
          class="nav-link inline-flex w-full items-center justify-center rounded-lg border-2 border-accent-500 px-4 py-3 text-sm font-bold uppercase tracking-wide text-accent-600 no-underline transition hover:bg-accent-50"
        >
          Request a Free Quote
        </a>
      </li>
      <li>
        <PhoneLink class="w-full" showIcon ariaLabel={`Call ${site.name} at ${site.phone}`} />
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    mobileNav?.classList.toggle('hidden');
  });
</script>
