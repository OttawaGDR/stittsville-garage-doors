---
import { site } from '../data/site';
import PhoneLink from './PhoneLink.astro';

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/blog/', label: 'Blog' },
  { href: '/emergency/', label: 'Emergency' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-primary-100 bg-white/95 backdrop-blur">
  <div class="container-page flex items-center justify-between py-4">
    <a href="/" class="nav-link flex shrink-0 items-center no-underline hover:no-underline">
      <img
        src="/images/logo.svg"
        alt={site.name}
        width="240"
        height="42"
        class="h-9 w-auto md:h-10"
        fetchpriority="high"
      />
    </a>
    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link text-sm font-semibold uppercase tracking-wide no-underline hover:text-accent-600',
              path.startsWith(item.href.replace(/\/$/, '')) && item.href !== '/' ? 'text-accent-600' : 'text-primary-700',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="hidden lg:block">
      <PhoneLink showIcon />
    </div>
    <button
      type="button"
      class="lg:hidden rounded border border-primary-100 p-2"
      aria-label="Open menu"
      id="menu-toggle"
    >
      <svg width="24" height="24" class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-primary-100 bg-white lg:hidden" aria-label="Mobile">
    <ul class="container-page flex flex-col gap-2 py-4">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="nav-link block py-2 font-semibold text-primary-700 no-underline">
            {item.label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <PhoneLink class="w-full" showIcon />
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    mobileNav?.classList.toggle('hidden');
  });
</script>
