---
import { site } from '../data/site';
import PhoneLink from './PhoneLink.astro';

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/pricing/', label: 'Pricing' },
  { href: '/neighbourhoods/', label: 'Areas' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/emergency/', label: 'Emergency' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/contact/', label: 'Contact' },
];

const mobileMore = [
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;

const navLinkClass = (href: string) =>
  [
    'nav-link text-sm font-semibold uppercase tracking-wide no-underline hover:text-accent-600',
    path.startsWith(href.replace(/\/$/, '')) && href !== '/' ? 'text-accent-600' : 'text-primary-700',
  ] as const;
---

<header class="sticky top-0 z-40 border-b border-primary-100 bg-white/95 backdrop-blur">
  <div class="container-page py-3">
    <div class="flex items-center justify-between lg:hidden">
      <a href="/" class="nav-link flex shrink-0 items-center no-underline hover:no-underline">
        <img
          src="/images/logo.svg"
          alt={site.name}
          width="222"
          height="56"
          class="block h-9 w-auto"
          fetchpriority="high"
        />
      </a>
      <button
        type="button"
        class="rounded border border-primary-100 p-2"
        aria-label="Open menu"
        id="menu-toggle"
      >
        <svg width="24" height="24" class="h-6 w-6 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <div class="hidden items-center justify-center gap-3 lg:flex xl:gap-4">
      <a href="/" class="nav-link flex shrink-0 items-center no-underline hover:no-underline">
        <img
          src="/images/logo.svg"
          alt={site.name}
          width="222"
          height="56"
          class="block h-10 w-auto"
          fetchpriority="high"
        />
      </a>
      <nav class="flex flex-wrap items-center justify-center gap-3 xl:gap-4" aria-label="Main">
        {
          nav.map((item) => (
            <a href={item.href} class:list={navLinkClass(item.href)}>
              {item.label}
            </a>
          ))
        }
      </nav>
      <a
        href="/#request-quote"
        class="nav-link inline-flex shrink-0 items-center justify-center whitespace-nowrap rounded-lg border-2 border-accent-500 px-3 py-2 text-xs font-bold uppercase tracking-wide text-accent-600 no-underline transition hover:bg-accent-50"
      >
        Free Quote
      </a>
      <PhoneLink
        showIcon
        singleLine
        class="shrink-0 !px-3 !py-2 !text-sm"
        ariaLabel={`Call ${site.name} at ${site.phone}`}
      />
    </div>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-primary-100 bg-white lg:hidden" aria-label="Mobile">
    <ul class="container-page flex flex-col gap-2 py-4">
      {nav.map((item) => (
        <li>
          <a href={item.href} class="nav-link block py-2 font-semibold text-primary-700 no-underline">
            {item.label}
          </a>
        </li>
      ))}
      <li class="mt-1 border-t border-primary-100 pt-3">
        <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-primary-500">More</p>
        <ul class="flex flex-col gap-1">
          {mobileMore.map((item) => (
            <li>
              <a href={item.href} class="nav-link block py-1.5 text-sm text-primary-700 no-underline">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </li>
      <li class="pt-2">
        <a
          href="/#request-quote"
          class="nav-link inline-flex w-full items-center justify-center rounded-lg border-2 border-accent-500 px-4 py-3 text-sm font-bold uppercase tracking-wide text-accent-600 no-underline transition hover:bg-accent-50"
        >
          Request a Free Quote
        </a>
      </li>
      <li>
        <PhoneLink class="w-full" showIcon ariaLabel={`Call ${site.name} at ${site.phone}`} />
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    mobileNav?.classList.toggle('hidden');
  });
</script>
