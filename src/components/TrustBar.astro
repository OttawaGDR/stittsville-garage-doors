---
const badges = [
  { label: 'Insured', icon: 'shield' },
  { label: 'WSIB', icon: 'check' },
  { label: '1-Year Warranty', icon: 'warranty' },
  { label: 'Same-Day Service', icon: 'clock' },
];
---

<div class="flex flex-wrap items-center justify-center gap-6 text-sm text-primary-700">
  {
    badges.map((b) => (
      <span class="flex items-center gap-2 font-medium">
        <svg class="h-5 w-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {b.label}
      </span>
    ))
  }
</div>
