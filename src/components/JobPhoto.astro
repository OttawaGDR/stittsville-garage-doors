---
import type { JobPhoto } from '../data/jobPhotos';

interface Props {
  photo: JobPhoto;
  class?: string;
  priority?: boolean;
  sizes?: string;
}

const { photo, class: className = '', priority = false, sizes = '(max-width: 768px) 100vw, 50vw' } =
  Astro.props;
---

<figure class:list={['overflow-hidden rounded-xl border border-primary-100 bg-primary-50', className]}>
  <img
    src={photo.src}
    alt={photo.alt}
    width={photo.width}
    height={photo.height}
    loading={priority ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={priority ? 'high' : 'auto'}
    sizes={sizes}
    class="h-auto w-full object-cover"
  />
  {
    photo.caption && (
      <figcaption class="border-t border-primary-100 px-4 py-2 text-sm text-primary-600">
        {photo.caption}
      </figcaption>
    )
  }
</figure>
