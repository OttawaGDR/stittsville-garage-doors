---
import { site } from '../../data/site';
import { absoluteUrl } from '../../data/seo';

interface Props {
  serviceType: string;
  slug: string;
  minPrice: number;
  maxPrice?: number;
  description?: string;
}

const { serviceType, slug, minPrice, maxPrice, description } = Astro.props;
const serviceUrl = absoluteUrl(`/services/${slug}`);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${serviceUrl}#service`,
  name: serviceType,
  serviceType,
  description: description ?? `${serviceType} in Stittsville, Ontario.`,
  url: serviceUrl,
  provider: { '@id': `${site.url}/#business` },
  areaServed: { '@type': 'City', name: 'Stittsville' },
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'CAD',
    lowPrice: String(minPrice),
    highPrice: String(maxPrice ?? minPrice),
    offerCount: '1',
    url: serviceUrl,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
