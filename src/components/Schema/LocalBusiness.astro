---
import { site } from '../../data/site';
import { neighbourhoods } from '../../data/neighbourhoods';
import { services } from '../../data/services';
import { defaultDescription, defaultOgImage } from '../../data/seo';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': `${site.url}/#business`,
  name: site.name,
  description: defaultDescription,
  url: site.url,
  telephone: site.phoneRaw,
  email: site.email,
  image: [`${site.url}${defaultOgImage}`, `${site.url}/images/logo-mark.svg`],
  logo: `${site.url}/images/logo-mark.svg`,
  priceRange: 'CAD 129–2500',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Stittsville',
    addressRegion: 'ON',
    addressCountry: 'CA',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.serviceArea.coords.lat,
    longitude: site.serviceArea.coords.lng,
  },
  areaServed: [
    { '@type': 'City', name: 'Stittsville', containedInPlace: { '@type': 'AdministrativeArea', name: 'Ontario' } },
    ...neighbourhoods.map((n) => ({ '@type': 'Place', name: n.name })),
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '07:00',
      closes: '22:00',
    },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Garage door services',
    itemListElement: services.map((s, i) => ({
      '@type': 'Offer',
      position: i + 1,
      itemOffered: {
        '@type': 'Service',
        name: s.fullName,
        url: `${site.url}/services/${s.slug}/`,
      },
    })),
  },
  potentialAction: {
    '@type': 'CommunicateAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `tel:${site.phoneRaw}`,
      actionPlatform: [
        'http://schema.org/DesktopWebPlatform',
        'http://schema.org/MobileWebPlatform',
      ],
    },
    name: 'Call for garage door service',
  },
  sameAs: [site.social.yelp],
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
