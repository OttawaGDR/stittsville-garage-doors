---
import { absoluteUrl } from '../../data/seo';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: absoluteUrl(c.path),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
