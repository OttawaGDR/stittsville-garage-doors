---
import { site } from '../data/site';
import { services } from '../data/services';
import { neighbourhoods } from '../data/neighbourhoods';
import PhoneLink from './PhoneLink.astro';
---

<footer class="border-t border-primary-100 bg-primary-900 text-primary-50">
  <div class="container-page section-pad grid gap-12 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="inline-block no-underline" aria-label={`${site.name} — home`}>
        <img
          src="/images/logo-white.svg"
          alt=""
          width="280"
          height="56"
          class="h-9 w-auto md:h-10"
        />
      </a>
      <p class="mt-3 text-slate-200">{site.tagline}</p>
      <p class="mt-4 text-sm text-slate-200">{site.hours}</p>
      <div class="mt-4">
        <PhoneLink ariaLabel={`Call ${site.name} at ${site.phone}`} />
      </div>
    </div>
    <div>
      <h2 class="text-lg font-bold uppercase tracking-wide text-white">Services</h2>
      <ul class="mt-4 space-y-2.5 text-base leading-snug">
        {
          services.map((s) => (
            <li>
              <a href={`/services/${s.slug}/`}>{s.fullName}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="text-lg font-bold uppercase tracking-wide text-white">Neighbourhoods</h2>
      <ul class="mt-4 space-y-2.5 text-base leading-snug">
        {
          neighbourhoods.map((n) => (
            <li>
              <a href={`/neighbourhoods/${n.slug}/`}>{n.name}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h2 class="text-lg font-bold uppercase tracking-wide text-white">Company</h2>
      <ul class="mt-4 space-y-2.5 text-base leading-snug">
        <li><a href="/about/">About</a></li>
        <li><a href="/faq/">FAQ</a></li>
        <li><a href="/neighbourhoods/">Neighbourhoods</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/pricing/">Pricing</a></li>
        <li><a href="/reviews/">Reviews</a></li>
        <li><a href="/emergency/">Emergency</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/resources/winter-garage-door-guide/">Winter guide</a></li>
        <li><a href="/resources/stittsville-pricing-guide/">Pricing guide</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/20 py-6 text-center text-sm text-slate-300">
    <p>&copy; {new Date().getFullYear()} {site.legal.entity}. Serving {site.serviceArea.primary}.</p>
    <ul class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
      <li><a href="/privacy/" class="text-slate-300 hover:text-white">Privacy Policy</a></li>
      <li aria-hidden="true" class="text-white/30">&middot;</li>
      <li><a href="/terms/" class="text-slate-300 hover:text-white">Terms of Service</a></li>
      <li aria-hidden="true" class="text-white/30">&middot;</li>
      <li><a href="/accessibility/" class="text-slate-300 hover:text-white">Accessibility</a></li>
      <li aria-hidden="true" class="text-white/30">&middot;</li>
      <li><a href="/sitemap-index.xml" class="text-slate-300 hover:text-white">Sitemap</a></li>
    </ul>
  </div>
</footer>
