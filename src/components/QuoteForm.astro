---
import { site } from '../data/site';
import PhoneLink from './PhoneLink.astro';

interface Props {
  id?: string;
  redirectTo?: string;
  formSubject?: string;
  title?: string;
  subtitle?: string;
  submitLabel?: string;
  status?: 'sent' | 'error' | null;
  compact?: boolean;
  /** Hide the outer card styling when nested inside another panel */
  embedded?: boolean;
}

const {
  id = 'quote-form',
  redirectTo = `${site.url}/?sent=1#request-quote`,
  formSubject = 'New quote request — Stittsville Garage Doors',
  title = 'Request a free quote',
  subtitle = `Tell us what the door is doing — we will call or email you back, usually the same day for Stittsville addresses.`,
  submitLabel = 'Send quote request',
  status = null,
  compact = false,
  embedded = false,
} = Astro.props;
---

<div
  id={id}
  class:list={['scroll-mt-24', embedded ? '' : 'card']}
>
  <h2 class={compact ? 'text-2xl' : embedded ? 'text-2xl' : 'text-3xl'}>{title}</h2>
  {subtitle && <p class="mt-2 text-sm text-primary-600">{subtitle}</p>}

  <div class="mt-6 rounded-xl border border-primary-100 bg-primary-50/80 p-4">
    <p class="text-center text-sm font-semibold text-primary-900">Fastest response — call now</p>
    <div class="mt-3 flex justify-center">
      <PhoneLink showIcon singleLine class="w-full justify-center sm:w-auto" ariaLabel={`Call ${site.name} at ${site.phone}`} />
    </div>
    <p class="mt-3 text-center text-xs text-primary-600">Or send the form below — include your phone and email so we can reach you either way.</p>
  </div>

  <div
    id={`${id}-sent`}
    class={`mt-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-900${status === 'sent' ? '' : ' hidden'}`}
    role="status"
    data-quote-status="sent"
  >
    <p class="font-semibold">Thanks — your request was received.</p>
    <p class="mt-1">We will be in touch shortly, usually the same day. For urgent issues call <a href={`tel:${site.phoneRaw}`} class="font-semibold underline">{site.phone}</a>.</p>
  </div>
  <div
    id={`${id}-error`}
    class={`mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-900${status === 'error' ? '' : ' hidden'}`}
    role="alert"
    data-quote-status="error"
  >
    Something went wrong sending your request. Please call{' '}
    <a href={`tel:${site.phoneRaw}`} class="font-semibold underline">
      {site.phone}
    </a>{' '}
    or email{' '}
    <a href={`mailto:${site.email}`} class="font-semibold underline">
      {site.email}
    </a>
    .
  </div>

  <form class="mt-6 space-y-4" method="POST" action="https://formspree.io/f/xvzygnpo">
    <input type="hidden" name="_subject" value={formSubject} />
    <input type="hidden" name="_next" value={redirectTo} />
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for={`${id}-company`}>Company</label>
      <input type="text" id={`${id}-company`} name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label for={`${id}-name`} class="block text-sm font-semibold text-primary-900">Name</label>
        <input
          type="text"
          id={`${id}-name`}
          name="name"
          required
          autocomplete="name"
          class="mt-1 w-full rounded-lg border border-primary-200 px-4 py-3"
        />
      </div>
      <div>
        <label for={`${id}-phone`} class="block text-sm font-semibold text-primary-900">Phone</label>
        <input
          type="tel"
          id={`${id}-phone`}
          name="phone"
          required
          autocomplete="tel"
          inputmode="tel"
          placeholder="(613) 555-1234"
          class="mt-1 w-full rounded-lg border border-primary-200 px-4 py-3"
        />
      </div>
      <div class="sm:col-span-2">
        <label for={`${id}-email`} class="block text-sm font-semibold text-primary-900">Email</label>
        <input
          type="email"
          id={`${id}-email`}
          name="email"
          autocomplete="email"
          placeholder="you@example.com"
          class="mt-1 w-full rounded-lg border border-primary-200 px-4 py-3"
        />
      </div>
    </div>
    <div>
      <label for={`${id}-contact-method`} class="block text-sm font-semibold text-primary-900">
        Preferred contact method
      </label>
      <select
        id={`${id}-contact-method`}
        name="contact-method"
        class="mt-1 w-full rounded-lg border border-primary-200 px-4 py-3"
      >
        <option value="phone">Phone call</option>
        <option value="text">Text message</option>
        <option value="email">Email</option>
      </select>
    </div>
    <div>
      <label for={`${id}-address`} class="block text-sm font-semibold text-primary-900">
        Address (Stittsville neighbourhood)
      </label>
      <input
        type="text"
        id={`${id}-address`}
        name="address"
        required
        autocomplete="street-address"
        placeholder="e.g. 42 Bridlewood Drive, Jackson Trails"
        class="mt-1 w-full rounded-lg border border-primary-200 px-4 py-3"
      />
    </div>
    <div>
      <label for={`${id}-message`} class="block text-sm font-semibold text-primary-900">
        What&apos;s wrong with the door?
      </label>
      <textarea
        id={`${id}-message`}
        name="message"
        rows="4"
        required
        placeholder="Spring snapped, opener hums but door won't move, door off track..."
        class="mt-1 w-full rounded-lg border border-primary-200 px-4 py-3"
      />
    </div>
    <div>
      <label for={`${id}-best-time`} class="block text-sm font-semibold text-primary-900">
        Best time to call you back
      </label>
      <select
        id={`${id}-best-time`}
        name="best-time"
        class="mt-1 w-full rounded-lg border border-primary-200 px-4 py-3"
      >
        <option value="asap">As soon as possible</option>
        <option value="morning">Morning (7 AM – 12 PM)</option>
        <option value="afternoon">Afternoon (12 PM – 5 PM)</option>
        <option value="evening">Evening (5 PM – 10 PM)</option>
      </select>
    </div>
    <button type="submit" class="btn-primary w-full">{submitLabel}</button>
  </form>
  <p class="mt-4 text-xs text-primary-500">
    Prefer email only? Write to{' '}
    <a href={`mailto:${site.email}?subject=Stittsville%20garage%20door%20quote`}>{site.email}</a>{' '}
    with the same details. No obligation, no dispatch fee — quotes are on-site and in writing.
  </p>
</div>

<script is:inline define:vars={{ formId: id }}>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var sent = params.get('sent');
    var err = params.get('error');
    var card = document.getElementById(formId);
    if (!card) return;
    var sentBox = document.getElementById(formId + '-sent');
    var errBox = document.getElementById(formId + '-error');
    if (sent && sentBox) {
      sentBox.classList.remove('hidden');
      var form = card.querySelector('form');
      if (form) form.style.display = 'none';
      card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      var url = new URL(window.location.href);
      url.searchParams.delete('sent');
      window.history.replaceState({}, '', url.toString() + (window.location.hash || ''));
    } else if (err && errBox) {
      errBox.classList.remove('hidden');
      card.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    var methodSelect = document.getElementById(formId + '-contact-method');
    var emailInput = document.getElementById(formId + '-email');
    if (methodSelect && emailInput) {
      function syncContactMethod() {
        emailInput.required = methodSelect.value === 'email';
      }
      methodSelect.addEventListener('change', syncContactMethod);
      syncContactMethod();
    }
  })();
</script>
