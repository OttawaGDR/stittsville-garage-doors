---
import TrustBar from './TrustBar.astro';
import PhoneLink from './PhoneLink.astro';
import type { JobPhoto } from '../data/jobPhotos';

interface Props {
  title: string;
  subtitle: string;
  showPricingCta?: boolean;
  showQuoteCta?: boolean;
  image?: JobPhoto;
  eyebrow?: string | null;
}

const {
  title,
  subtitle,
  showPricingCta = true,
  showQuoteCta = false,
  image,
  eyebrow = 'Stittsville, Ontario',
} = Astro.props;
---

<section class="relative overflow-hidden bg-primary-900 text-white">
  {
    image && (
      <>
        <img
          src={image.src}
          alt=""
          width={image.width}
          height={image.height}
          class="absolute inset-0 h-full w-full object-cover object-center"
          fetchpriority="high"
          decoding="async"
          aria-hidden="true"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-primary-900 via-primary-900/92 to-primary-900/75" aria-hidden="true" />
      </>
    )
  }
  {
    !image && (
      <div
        class="absolute inset-0 bg-gradient-to-br from-primary-900 via-primary-700/80 to-primary-900 opacity-95"
        aria-hidden="true"
      />
    )
  }
  <div class="container-page relative grid gap-10 py-16 md:grid-cols-2 md:items-center md:py-24">
    <div>
      {eyebrow && (
        <p class="text-sm font-semibold uppercase tracking-widest text-accent-400">{eyebrow}</p>
      )}
      <h1 class={eyebrow ? 'mt-4 max-w-3xl text-white' : 'max-w-3xl text-white'}>{title}</h1>
      <p class="mt-6 max-w-2xl text-lg text-slate-200">{subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <PhoneLink showIcon />
        {
          showQuoteCta && (
            <a href="#request-quote" class="btn-secondary border-white text-white hover:bg-white/10">
              Request a Free Quote
            </a>
          )
        }
        {
          showPricingCta && (
            <a href="/pricing/" class="btn-secondary border-white text-white hover:bg-white/10">
              See Pricing
            </a>
          )
        }
      </div>
      <div class="mt-10 [&_*]:text-slate-200">
        <TrustBar />
      </div>
    </div>
    {
      image && (
        <figure class="hidden overflow-hidden rounded-xl border-2 border-white/20 shadow-2xl md:block">
          <img
            src={image.src}
            alt={image.alt}
            width={image.width}
            height={image.height}
            fetchpriority="high"
            decoding="async"
            class="aspect-[4/5] w-full object-cover"
          />
        </figure>
      )
    }
  </div>
</section>
