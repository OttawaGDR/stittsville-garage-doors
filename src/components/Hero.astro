---
import TrustBar from './TrustBar.astro';
import PhoneLink from './PhoneLink.astro';

interface Props {
  title: string;
  subtitle: string;
  showPricingCta?: boolean;
}

const { title, subtitle, showPricingCta = true } = Astro.props;
---

<section class="relative overflow-hidden bg-primary-900 text-white">
  <div class="absolute inset-0 bg-gradient-to-br from-primary-900 via-primary-700/80 to-primary-900 opacity-95" aria-hidden="true" />
  <div class="container-page relative section-pad">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent-400">Stittsville · K2S · K2V</p>
    <h1 class="mt-4 max-w-3xl text-white">{title}</h1>
    <p class="mt-6 max-w-2xl text-lg text-primary-100">{subtitle}</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <PhoneLink showIcon />
      {
        showPricingCta && (
          <a href="/pricing/" class="btn-secondary border-white text-white hover:bg-white/10">
            See Pricing
          </a>
        )
      }
    </div>
    <div class="mt-10 [&_*]:text-primary-100">
      <TrustBar />
    </div>
  </div>
</section>
