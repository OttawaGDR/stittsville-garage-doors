---
import type { BlogPost } from '../data/blog/types';
import { formatBlogDate } from '../data/blog/utils';

interface Props {
  post: BlogPost;
  featured?: boolean;
}

const { post, featured = false } = Astro.props;
const href = `/blog/${post.slug}/`;
---

<article
  class:list={[
    'group flex h-full flex-col overflow-hidden rounded-xl border border-primary-100 bg-white transition hover:border-primary-200 hover:shadow-lg',
    featured && 'md:flex-row md:items-stretch',
  ]}
>
  <div class:list={['flex flex-1 flex-col p-6 md:p-8', featured && 'md:justify-center']}>
    <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider text-primary-600">
      <span class="rounded-full bg-primary-50 px-3 py-1 text-primary-700">{post.category}</span>
      <span class="text-primary-400">·</span>
      <time datetime={post.publishedAt}>{formatBlogDate(post.publishedAt)}</time>
      <span class="text-primary-400">·</span>
      <span>{post.readMinutes} min read</span>
    </div>
    <h2 class:list={['mt-4', featured ? 'text-2xl md:text-3xl' : 'text-xl']}>
      <a href={href} class="text-primary-900 no-underline group-hover:text-accent-600">
        {post.title}
      </a>
    </h2>
    <p class="mt-3 flex-1 text-primary-700 leading-relaxed">{post.excerpt}</p>
    <a
      href={href}
      class="mt-5 inline-flex items-center gap-1 text-sm font-bold uppercase tracking-wide text-accent-600 no-underline group-hover:gap-2"
    >
      Read article
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
