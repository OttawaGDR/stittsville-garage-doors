---
import type { BlogBlock } from '../data/blog/types';
import { slugifyHeading } from '../data/blog/utils';

interface Props {
  blocks: BlogBlock[];
}

const { blocks } = Astro.props;

function headingId(block: BlogBlock): string | undefined {
  if (block.type === 'h2' || block.type === 'h3') {
    return block.id ?? slugifyHeading(block.text);
  }
  return undefined;
}
---

<div class="blog-prose">
  {
    blocks.map((block) => {
      if (block.type === 'p') {
        return <p set:html={block.text} />;
      }
      if (block.type === 'h2') {
        return (
          <h2 id={headingId(block)} class="scroll-mt-28">
            {block.text}
          </h2>
        );
      }
      if (block.type === 'h3') {
        return (
          <h3 id={headingId(block)} class="scroll-mt-28">
            {block.text}
          </h3>
        );
      }
      if (block.type === 'ul') {
        return (
          <ul class="mb-6 list-disc space-y-2 pl-6">
            {block.items.map((item) => (
              <li set:html={item} />
            ))}
          </ul>
        );
      }
      if (block.type === 'ol') {
        return (
          <ol class="mb-6 list-decimal space-y-2 pl-6">
            {block.items.map((item) => (
              <li set:html={item} />
            ))}
          </ol>
        );
      }
      if (block.type === 'callout') {
        return (
          <aside
            class:list={[
              'blog-callout my-8 rounded-xl border-l-4 p-5',
              block.variant === 'warning' && 'border-amber-500 bg-amber-50',
              block.variant === 'tip' && 'border-emerald-600 bg-emerald-50',
              block.variant === 'info' && 'border-primary-500 bg-primary-50',
            ]}
          >
            {block.title && <p class="mb-2 font-bold text-primary-900">{block.title}</p>}
            <p class="mb-0 text-primary-700" set:html={block.text} />
          </aside>
        );
      }
      return null;
    })
  }
</div>
