---
import { site } from '../data/site';

interface Props {
  class?: string;
  showIcon?: boolean;
}

const { class: className = '', showIcon = false } = Astro.props;
---

<a href={`tel:${site.phoneRaw}`} class:list={['btn-phone', className]}>
  {
    showIcon && (
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24 11.36 11.36 0 003.56.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1 11.36 11.36 0 00.57 3.56 1 1 0 01-.24 1.01l-2.2 2.22z" />
      </svg>
    )
  }
  {site.phone}
</a>
