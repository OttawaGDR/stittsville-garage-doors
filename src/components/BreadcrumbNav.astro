---
interface Crumb {
  name: string;
  path: string;
}

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="text-sm text-primary-600" aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      crumbs.map((c, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && (
            <span class="text-primary-300 select-none" aria-hidden="true">
              ›
            </span>
          )}
          {i === crumbs.length - 1 ? (
            <span class="font-semibold text-primary-900">{c.name}</span>
          ) : (
            <a href={c.path} class="text-primary-700 no-underline hover:text-accent-600 hover:underline">
              {c.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
