---
import { Fragment } from 'astro/jsx-runtime';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PhoneLink from '../components/PhoneLink.astro';
import QuoteForm from '../components/QuoteForm.astro';
import BreadcrumbSchema from '../components/Schema/Breadcrumb.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import { site } from '../data/site';

import { pageTitle } from '../data/seo';

const title = pageTitle('Contact Stittsville Garage Doors', { includePhone: true });
const description = `Contact Stittsville garage door repair. Call ${site.phone} or send a message — same-day service across Stittsville. Hours: ${site.hours}.`;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];

const mapEmbed = `https://maps.google.com/maps?q=${site.serviceArea.coords.lat},${site.serviceArea.coords.lng}&z=13&hl=en&output=embed`;

const status = Astro.url.searchParams.get('sent')
  ? 'sent'
  : Astro.url.searchParams.get('error')
    ? 'error'
    : null;
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <BreadcrumbSchema crumbs={crumbs} />
  </Fragment>

  <Hero
    title="Contact Stittsville Garage Doors"
    subtitle="Call, text, or send the form below — include your Stittsville address so we know drive time from Hazeldean or Main Street."
    showPricingCta={false}
  />

  <div class="container-page border-b border-primary-100 bg-primary-50/50 py-3 md:py-4">
    <BreadcrumbNav crumbs={crumbs} />
  </div>

  <section class="container-page section-pad">
    <div class="prose-content mb-12 max-w-none">
      <p>
        The fastest way to book garage door repair in Stittsville is still a phone call — we can hear in thirty seconds whether you are dealing with a snapped spring, a door off track, or an opener sensor covered in frost after a Wyldewood cold night. If you prefer email or the form below, include your street and neighbourhood (Jackson Trails, Fairwinds, Amberwood Village, etc.) so we estimate drive time from Hazeldean or Main Street accurately.
      </p>
    </div>
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl">Call or email</h2>
        <p class="mt-4 text-lg text-primary-700">
          Fastest response: <a href={`tel:${site.phoneRaw}`} class="font-display text-2xl font-bold text-accent-600 no-underline">{site.phone}</a>
        </p>
        <ul class="mt-6 space-y-4 text-primary-700">
          <li><strong>Hours:</strong> {site.hours}</li>
          <li><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><strong>Service area:</strong> {site.serviceArea.primary}</li>
          <li><strong>Response time:</strong> Most Stittsville calls get a same-day window; average under 90 minutes when trucks are on the west Ottawa route.</li>
        </ul>
        <div class="mt-8">
          <PhoneLink showIcon />
        </div>
        <p class="mt-6 text-sm text-primary-500">
          Door stuck open overnight? See our <a href="/emergency/">24/7 emergency garage door repair</a> page.
        </p>
      </div>

      <QuoteForm
        id="contact-form"
        redirectTo={`${site.url}/contact/?sent=1`}
        formSubject="New contact message — Stittsville Garage Doors"
        title="Request a callback"
        subtitle={`We call or email you back — usually the same day for Stittsville addresses.`}
        submitLabel="Send message"
        status={status}
      />
    </div>

    <div class="mt-16">
      <h2 class="text-center text-3xl">Stittsville service area</h2>
      <p class="mx-auto mt-4 max-w-2xl text-center text-primary-700">
        We do not list a fake storefront address — this map shows where we work: Stittsville, Ontario, centred on the village core near Stittsville Main Street and Hazeldean Road.
      </p>
      <div class="mt-8 overflow-hidden rounded-xl border border-primary-100 shadow-lg">
        <iframe
          title="Stittsville garage door service area map"
          src={mapEmbed}
          width="100%"
          height="400"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </div>
    </div>
  </section>
</Base>
