---
import { Fragment } from 'astro/jsx-runtime';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import PhoneLink from '../components/PhoneLink.astro';
import BreadcrumbSchema from '../components/Schema/Breadcrumb.astro';
import { site } from '../data/site';

const title = `Contact Stittsville Garage Doors | ${site.phone}`;
const description = `Contact Stittsville garage door repair. Call ${site.phone} or send a message — same-day service across K2S & K2V. Hours: ${site.hours}.`;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];

const mapEmbed = `https://maps.google.com/maps?q=${site.serviceArea.coords.lat},${site.serviceArea.coords.lng}&z=13&hl=en&output=embed`;
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <BreadcrumbSchema crumbs={crumbs} />
  </Fragment>

  <Hero
    title="Contact Stittsville Garage Doors"
    subtitle="Call, text, or send the form below — include your Stittsville address so we know drive time from Hazeldean or Main Street."
    showPricingCta={false}
  />

  <section class="container-page section-pad">
    <div class="prose-content mb-12 max-w-none">
      <p>
        The fastest way to book garage door repair in Stittsville is still a phone call — we can hear in thirty seconds whether you are dealing with a snapped spring, a door off track, or an opener sensor covered in frost after a Wyldewood cold night. If you prefer email or the form below, include your street and neighbourhood (Jackson Trails, Fairwinds, Amberwood Village, etc.) so we estimate drive time from Hazeldean or Main Street accurately.
      </p>
    </div>
    <div class="grid gap-12 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl">Call or email</h2>
        <p class="mt-4 text-lg text-primary-700">
          Fastest response: <a href={`tel:${site.phoneRaw}`} class="font-display text-2xl font-bold text-accent-600 no-underline">{site.phone}</a>
        </p>
        <ul class="mt-6 space-y-4 text-primary-700">
          <li><strong>Hours:</strong> {site.hours}</li>
          <li><strong>Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><strong>Service area:</strong> {site.serviceArea.primary} ({site.serviceArea.postalCodes.join(', ')})</li>
          <li><strong>Response time:</strong> Most Stittsville calls get a same-day window; average under 90 minutes when trucks are on the west Ottawa route.</li>
        </ul>
        <div class="mt-8">
          <PhoneLink showIcon />
        </div>
        <p class="mt-6 text-sm text-primary-500">
          Door stuck open overnight? See our <a href="/emergency/">24/7 emergency garage door repair</a> page.
        </p>
      </div>

      <div class="card">
        <h2 class="text-2xl">Request a callback</h2>
        <p class="mt-2 text-sm text-primary-600">
          Form posts to <code class="text-xs">/api/contact</code>. On Vercel, wire this to Vercel Forms or your serverless handler — no CAPTCHA puzzles, honeypot only.
        </p>
        <form class="mt-6 space-y-4" method="POST" action="/api/contact">
          <div class="absolute -left-[9999px]" aria-hidden="true">
            <label for="company">Company</label>
            <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
          </div>
          <div>
            <label for="name" class="block text-sm font-semibold text-primary-900">Name</label>
            <input type="text" id="name" name="name" required class="mt-1 w-full rounded-lg border border-primary-200 px-4 py-3" />
          </div>
          <div>
            <label for="phone" class="block text-sm font-semibold text-primary-900">Phone</label>
            <input type="tel" id="phone" name="phone" required class="mt-1 w-full rounded-lg border border-primary-200 px-4 py-3" />
          </div>
          <div>
            <label for="address" class="block text-sm font-semibold text-primary-900">Address (Stittsville neighbourhood)</label>
            <input
              type="text"
              id="address"
              name="address"
              required
              placeholder="e.g. 42 Bridlewood Drive, Jackson Trails"
              class="mt-1 w-full rounded-lg border border-primary-200 px-4 py-3"
            />
          </div>
          <div>
            <label for="message" class="block text-sm font-semibold text-primary-900">What&apos;s wrong?</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Spring snapped, opener hums but door won't move, door off track..."
              class="mt-1 w-full rounded-lg border border-primary-200 px-4 py-3"
            />
          </div>
          <div>
            <label for="best-time" class="block text-sm font-semibold text-primary-900">Best time to call</label>
            <select id="best-time" name="best-time" class="mt-1 w-full rounded-lg border border-primary-200 px-4 py-3">
              <option value="morning">Morning (7 AM – 12 PM)</option>
              <option value="afternoon">Afternoon (12 PM – 5 PM)</option>
              <option value="evening">Evening (5 PM – 10 PM)</option>
              <option value="asap">As soon as possible</option>
            </select>
          </div>
          <button type="submit" class="btn-primary w-full">Send message</button>
        </form>
        <p class="mt-4 text-xs text-primary-500">
          Prefer email only? Write to <a href={`mailto:${site.email}?subject=Stittsville%20garage%20door%20repair`}>{site.email}</a> with the same details. If the form is not yet connected in production, calling {site.phone} is always fastest.
        </p>
      </div>
    </div>

    <div class="mt-16">
      <h2 class="text-center text-3xl">Stittsville service area</h2>
      <p class="mx-auto mt-4 max-w-2xl text-center text-primary-700">
        We do not list a fake storefront address — this map shows where we work: Stittsville, Ontario (K2S, K2V), centred on the village core near Stittsville Main Street and Hazeldean Road.
      </p>
      <div class="mt-8 overflow-hidden rounded-xl border border-primary-100 shadow-lg">
        <iframe
          title="Stittsville garage door service area map"
          src={mapEmbed}
          width="100%"
          height="400"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </div>
    </div>
  </section>
</Base>
