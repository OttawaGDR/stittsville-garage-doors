---
import { Fragment } from 'astro/jsx-runtime';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import GdsReviewCard from '../components/GdsReviewCard.astro';
import BreadcrumbSchema from '../components/Schema/Breadcrumb.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import { site } from '../data/site';
import { gdsParentReviews } from '../data/gdsParentReviews';

const title = `Customer Reviews — Stittsville Garage Doors`;
const description = `Real GDS Ottawa customer reviews, honestly attributed. Stittsville-specific reviews coming as customers leave feedback. Call ${site.phone}.`;

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Reviews', path: '/reviews/' },
];
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <BreadcrumbSchema crumbs={crumbs} />
  </Fragment>

  <Hero
    title="Customer Reviews — Stittsville Garage Doors"
    subtitle="Honest reviews from our Ottawa work under GDS — plus room for Stittsville customers as they come in."
    showPricingCta={false}
  />

  <div class="container-page border-b border-primary-100 bg-primary-50/50 py-3 md:py-4">
    <BreadcrumbNav crumbs={crumbs} />
  </div>

  <section class="container-page section-pad">
    <div class="prose-content max-w-none">
      <p>
        Stittsville Garage Doors operates under GDS — Garage Doors & Openers Ottawa. The
        reviews on this page come from our wider Ottawa work, where the same technician team
        has been handling springs, openers, cables, and full door installations for several
        years. As Stittsville-specific reviews come in from our newest customers, they will
        appear in their own section below — separate and clearly labelled.
      </p>
      <p>
        <a href={site.parent.reviewsUrl}>See the full GDS Ottawa review history →</a>
      </p>
    </div>

    <section class="mt-12">
      <h2>Reviews from our Ottawa work under GDS</h2>
      <p class="prose-content mb-8 mt-4 max-w-none">
        These are real customer reviews, each tied to a real job under GDS — Garage Doors &amp;
        Openers Ottawa. The customer names, locations, and review text below match what those
        customers wrote on their original review platform.
      </p>

      <div class="mt-8 grid gap-6 md:grid-cols-2">
        {gdsParentReviews.map((review) => <GdsReviewCard review={review} />)}
      </div>
    </section>

    <section class="card mt-16">
      <h2 class="text-2xl">Be one of our first Stittsville reviewers</h2>
      <p class="mt-4">
        Book any garage door repair or installation at a Stittsville address and leave an
        honest review after the job is done — positive or critical. We take $20 off your
        invoice on the spot as thanks for helping us build out a Stittsville-specific review
        history. The discount applies to leaving a review, not to the content of it. Real
        feedback only.
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a href={`tel:${site.phoneRaw}`} class="btn-phone" aria-label={`Call ${site.name} at ${site.phone}`}>
          {site.phone}
        </a>
        <a href="/#request-quote" class="btn-secondary">Request a free quote</a>
      </div>
    </section>
  </section>
</Base>
