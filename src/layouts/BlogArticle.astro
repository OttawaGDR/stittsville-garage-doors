---
import { Fragment } from 'astro/jsx-runtime';
import Base from './Base.astro';
import BlogBody from '../components/BlogBody.astro';
import BlogCard from '../components/BlogCard.astro';
import PhoneLink from '../components/PhoneLink.astro';
import BreadcrumbSchema from '../components/Schema/Breadcrumb.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import BlogPostingSchema from '../components/Schema/BlogPosting.astro';
import { site } from '../data/site';
import { getRelatedPosts, getTocFromPost } from '../data/blog';
import type { BlogPost } from '../data/blog/types';
import { formatBlogDate } from '../data/blog/utils';
import { getService } from '../data/services';
import { metaDescription } from '../data/seo';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const toc = getTocFromPost(post);
const related = getRelatedPosts(post);
const title = `${post.title} | ${site.name}`;
const description = metaDescription(post.metaDescription);

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.title, path: `/blog/${post.slug}/` },
];
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <BreadcrumbSchema crumbs={crumbs} />
    <BlogPostingSchema post={post} />
  </Fragment>

  <header class="border-b border-primary-100 bg-gradient-to-br from-primary-900 via-primary-800 to-primary-900 text-white">
    <div class="container-page py-12 md:py-16">
      <p class="mt-4 flex flex-wrap items-center gap-3 text-sm font-semibold uppercase tracking-wider text-accent-400">
        <span>{post.category}</span>
        <span class="text-primary-400">·</span>
        <time datetime={post.publishedAt}>Published {formatBlogDate(post.publishedAt)}</time>
        {
          post.updatedAt !== post.publishedAt && (
            <>
              <span class="text-primary-400">·</span>
              <time datetime={post.updatedAt}>Updated {formatBlogDate(post.updatedAt)}</time>
            </>
          )
        }
        <span class="text-primary-400">·</span>
        <span>{post.readMinutes} min read</span>
      </p>
      <h1 class="mt-6 max-w-4xl text-white">{post.title}</h1>
      <p class="mt-6 max-w-3xl text-lg text-slate-200">{post.excerpt}</p>
    </div>
  </header>

  <div class="container-page border-b border-primary-100 bg-primary-50/50 py-3 md:py-4">
    <BreadcrumbNav crumbs={crumbs} />
  </div>

  <div class="container-page section-pad">
    <div class="lg:grid lg:grid-cols-[minmax(0,1fr)_280px] lg:gap-12">
      <article>
        <aside class="blog-key-takeaways mb-10 rounded-xl border border-primary-100 bg-primary-50 p-6 md:p-8">
          <p class="text-sm font-bold uppercase tracking-wide text-primary-900">Key takeaways</p>
          <ul class="mt-4 space-y-2">
            {
              post.keyTakeaways.map((t) => (
                <li class="flex gap-2 text-primary-800">
                  <span class="text-accent-600" aria-hidden="true">
                    ✓
                  </span>
                  {t}
                </li>
              ))
            }
          </ul>
        </aside>

        <BlogBody blocks={post.blocks} />

        {
          post.relatedServiceSlugs && post.relatedServiceSlugs.length > 0 && (
            <aside class="mt-12 rounded-xl border border-primary-100 bg-white p-6">
              <h2 class="text-xl">Related services</h2>
              <ul class="mt-4 space-y-2">
                {
                  post.relatedServiceSlugs.map((slug) => {
                    const s = getService(slug);
                    if (!s) return null;
                    return (
                      <li>
                        <a href={`/services/${slug}/`} class="font-semibold">
                          {s.fullName}
                        </a>
                        <span class="text-sm text-primary-600">
                          {' '}
                          — {s.priceLabel ?? `from $${s.startingPrice}`}
                        </span>
                      </li>
                    );
                  })
                }
              </ul>
            </aside>
          )
        }

        <aside class="card mt-12 bg-primary-900 text-center text-white">
          <h2 class="text-2xl text-white">Need help in Stittsville?</h2>
          <p class="mt-2 text-primary-100">Free on-site estimate and written quote before any repair.</p>
          <div class="mt-6 flex justify-center">
            <PhoneLink showIcon />
          </div>
        </aside>
      </article>

      <aside class="mt-12 lg:mt-0">
        <div class="space-y-8 lg:sticky lg:top-24">
          {
            toc.length > 2 && (
              <nav class="rounded-xl border border-primary-100 bg-white p-5" aria-label="On this page">
                <p class="text-sm font-bold uppercase tracking-wide text-primary-900">On this page</p>
                <ul class="mt-4 space-y-2 text-sm">
                  {
                    toc.map((item) => (
                      <li class:list={[item.level === 3 && 'ml-4']}>
                        <a href={`#${item.id}`} class="text-primary-700 no-underline hover:text-accent-600">
                          {item.text}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </nav>
            )
          }
          <div class="rounded-xl border border-accent-200 bg-accent-50 p-5">
            <p class="text-sm font-bold uppercase tracking-wide text-primary-900">Typical pricing</p>
            <p class="mt-2 text-sm text-primary-700">
              Ranges in this article match our <a href="/pricing/">live pricing page</a>. Your written on-site quote is
              the number you approve.
            </p>
            <a href="/pricing/" class="btn-primary mt-4 block text-center text-xs">View pricing</a>
          </div>
          <div class="rounded-xl border border-primary-100 bg-white p-5 text-center">
            <p class="font-bold text-primary-900">Call {site.phone}</p>
            <p class="mt-1 text-sm text-primary-600">7 AM – 10 PM · 7 days</p>
            <div class="mt-4">
              <PhoneLink showIcon class="w-full" />
            </div>
          </div>
        </div>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="mt-20 border-t border-primary-100 pt-16">
          <h2 class="text-3xl">Continue reading</h2>
          <div class="mt-8 grid gap-6 md:grid-cols-3">
            {related.map((p) => <BlogCard post={p} />)}
          </div>
        </section>
      )
    }
  </div>
</Base>
